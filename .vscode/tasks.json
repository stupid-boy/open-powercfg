{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-OpenPowerCfg",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/OpenPowerCfg.csproj",
                "--configuration",
                "Debug",
                "--output",
                "${workspaceFolder}/Bin/Debug/netcoreapp3.0",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}